#!/usr/bin/expect -f
# Test: Type text in Scheme editor, upcase word with M-u, quit
set timeout 300 ; # A cold AOT cache build can be slow on CI

set script_dir [file dirname [info script]]
set repo_dir [file join $script_dir ..]
source [file join $script_dir testlib.exp]
spawn_shemacs $repo_dir

expect {
    -re {em: ?shemacs} { puts "\nPASS: editor started" }
    timeout { puts "\nFAIL: editor did not start"; exit 1 }
}

set timeout 60 ; # Scheme editor is slow on CI (~2s/keystroke)

# Type text
send "hello"
sleep 2

# C-a to go to beginning of line
send "\x01"
sleep 1

# M-u (ESC then u) to upcase word
send "\x1b"
sleep 0.3
send "u"
sleep 2

expect {
    "HELLO" { puts "PASS: upcase word worked" }
    timeout { puts "FAIL: upcase not visible"; exit 1 }
}

# C-x C-c to quit (modified scratch buffers do not require confirmation)
send "\x18\x03"
sleep 1

expect {
    eof { puts "PASS: editor exited cleanly" }
    timeout { puts "FAIL: editor did not exit"; exit 1 }
}

puts "TEST PASSED: scheme upcase word"
